generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReleaseStatus {
  AIRING
  COMPLETED
  UPCOMING
}

enum MediaType {
  MOVIE
  SERIES
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Movie {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  originalTitle  String?
  synopsis       String         @db.Text
  posterUrl      String
  backdropUrl    String?
  releaseYear    Int
  durationMinutes Int?
  rating         Float          @default(0)
  type           MediaType      @default(MOVIE)
  status         ReleaseStatus  @default(COMPLETED)
  episodeCount  Int?
  airedEpisodes Int?
  isFeatured     Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  genres         MovieGenre[]
  episodes       Episode[]
  downloads      DownloadLink[]
  subtitles      Subtitle[]
  comments       Comment[]
  cast           MovieCast[]
  gallery        GalleryImage[]

  @@index([type, releaseYear])
  @@index([isFeatured])
}

model Genre {
  id     String       @id @default(cuid())
  name   String       @unique
  slug   String       @unique
  movies MovieGenre[]
}

model MovieGenre {
  movieId String
  genreId String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model Episode {
  id             String   @id @default(cuid())
  movieId        String
  seasonNumber   Int
  episodeNumber  Int
  title          String
  synopsis       String?  @db.Text
  durationMinutes Int?
  videoUrl       String?
  publishedAt    DateTime?
  movie          Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([movieId, seasonNumber, episodeNumber])
  @@index([movieId, seasonNumber, episodeNumber])
}

model DownloadLink {
  id         String   @id @default(cuid())
  movieId    String
  label      String
  quality    String
  language   String   @default("فارسی")
  url        String
  size       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model Subtitle {
  id        String   @id @default(cuid())
  movieId   String
  language  String
  format    String   @default("SRT")
  url       String
  isForced  Boolean  @default(false)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model Person {
  id        String      @id @default(cuid())
  name      String
  photoUrl  String?
  cast      MovieCast[]
}

model MovieCast {
  movieId  String
  personId String
  role     String?
  movie    Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([movieId, personId])
}

model Comment {
  id        String        @id @default(cuid())
  movieId   String
  author    String
  body      String        @db.Text
  hasSpoiler Boolean      @default(false)
  status    CommentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  movie     Movie         @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId, status, createdAt])
}

model GalleryImage {
  id        String   @id @default(cuid())
  movieId   String
  imageUrl  String
  caption   String?
  sortOrder Int      @default(0)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model Support {
  id            String   @id @default(cuid())
  supporterName String?
  amount        Int
  currency      String   @default("IRR")
  message       String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
}
